# Host port the app is published on (docker compose)
PORT=8080
# Maximum accepted upload size in MB (0 = unlimited)
MAX_UPLOAD_MB=0
# Simultaneous compression jobs (each one is CPU/RAM heavy)
MAX_CONCURRENT_JOBS=2
# Per-request compression deadline in seconds
JOB_TIMEOUT_SECONDS=300
# Optional: explicit Ghostscript path if it's not on PATH (non-Docker runs)
# GS_BIN=/usr/bin/gs
